# Copie este arquivo para ".env" (na pasta onde você roda o comando).

# Modo grátis (padrão): tudo por copiar/colar no claude.ai, inclusive dizer onde está cada parte
# (braço, olho, sol...) na imagem. Nada de API, nada de custo.
ANIMACAO2D_IA=manual

# ------------------------------------------------------------------------------------------
# Opcional, só se um dia quiser automatizar (API paga à parte, em console.anthropic.com):
# troque a linha acima por ANIMACAO2D_IA=api e preencha a chave.
# ANTHROPIC_API_KEY=sk-ant-...
# ANIMACAO2D_MODELO=claude-opus-5
# ANIMACAO2D_MODELO_VISAO=claude-opus-5

# Opcional: pasta onde os projetos são criados (padrão: ./projetos)
# ANIMACAO2D_PASTA_PROJETOS=projetos
