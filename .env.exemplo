# Copie este arquivo para ".env" (na pasta onde você roda o comando) e preencha.
# Chave da API da Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo usado para títulos, roteiro e cenas (padrão: claude-opus-5)
# ANIMACAO2D_MODELO=claude-opus-5

# Opcional: modelo usado para localizar partes nas imagens (padrão: o mesmo acima)
# ANIMACAO2D_MODELO_VISAO=claude-opus-5

# Opcional: pasta onde os projetos são criados (padrão: ./projetos)
# ANIMACAO2D_PASTA_PROJETOS=projetos
