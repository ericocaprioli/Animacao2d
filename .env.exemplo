# Copie este arquivo para ".env" (na pasta onde você roda o comando) e preencha.

# Chave da API da Anthropic: https://console.anthropic.com/
# No modo "texto manual" abaixo, ela só é usada na animação (localizar braço, olho, sol... nas imagens).
ANTHROPIC_API_KEY=sk-ant-...

# Títulos, roteiro e cenas sem gastar API: você cola cada pedido no claude.ai e cola a resposta
# de volta no terminal. Apague esta linha para a API fazer tudo sozinha.
ANIMACAO2D_TEXTO=manual

# Opcional: modelo usado para títulos, roteiro e cenas quando não estiver no modo manual
# ANIMACAO2D_MODELO=claude-opus-5

# Opcional: modelo usado para localizar as partes nas imagens (padrão: claude-opus-5)
# ANIMACAO2D_MODELO_VISAO=claude-opus-5

# Opcional: pasta onde os projetos são criados (padrão: ./projetos)
# ANIMACAO2D_PASTA_PROJETOS=projetos
